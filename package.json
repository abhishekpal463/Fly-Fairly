{
  "name": "airport-autocomplete",
  "version": "0.1.0",
  "description": "Production-quality airport and city autocomplete service for Fly Fairly",
  "main": "backend/src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only backend/src/index.ts",
    "build": "tsc",
    "start": "node backend/dist/index.js",
    "etl:ingest": "ts-node-dev data/etl/ingest_ourairports.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "eval": "node tests/eval/harness.js"
  },
  "keywords": [
    "airport",
    "autocomplete",
    "search",
    "elasticsearch"
  ],
  "author": "Fly Fairly",
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "@elastic/elasticsearch": "^9.4.2",
    "better-sqlite3": "^12.10.0",
    "axios": "^1.16.1",
    "ioredis": "^5.11.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "supertest": "^6.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/jest": "^29.5.8",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  }
}
